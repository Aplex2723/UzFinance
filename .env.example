# Copia a .env (local). NUNCA commitees .env. En Azure estas variables son App Settings.

# --- Autenticación ---
# dev = sin login, SOLO para `npm run dev` local. La app se niega a arrancar con dev en producción.
AUTH_MODE=dev
ALLOWED_EMAIL=uziel.francotorres@gmail.com
# Opcional (Azure): exige que el claim tid coincida con tu tenant.
# ALLOWED_TENANT_ID=

# --- Ingesta (Atajo de iPhone) ---
# Genera uno con: openssl rand -base64 48 | tr -d '=+/' | cut -c1-48
INGEST_TOKEN=
# Solo durante una rotación (ver README): el token anterior sigue siendo válido.
# INGEST_TOKEN_PREVIOUS=

# --- Categorización: rules | jev ---
# jev = reglas → historial (mismo comercio ya categorizado a mano) → Jev (OpenRouter). Sin la key cae a solo reglas.
CATEGORIZER=rules
# API key de OpenRouter (https://openrouter.ai/settings/keys). En Azure es App Setting; nunca en el repo.
# OPENROUTER_API_KEY=

# --- Base de datos ---
# Local (docker compose): autenticación por password.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=uzfinance
DB_AUTH=password
DB_USER=sa
DB_PASSWORD=
DB_SA_PASSWORD=          # mismo valor que DB_PASSWORD; lo usa docker-compose
DB_TRUST_SERVER_CERT=true
# Azure: DB_AUTH=msi, DB_SERVER=<servidor>.database.windows.net, DB_TRUST_SERVER_CERT=false

# Tokens del puente Gmail (nombre=token,otro=token; cada token >= 32). Distinto de INGEST_TOKEN.
EMAIL_INGEST_TOKENS=
