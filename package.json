{
  "name": "uzfinance",
  "version": "0.1.0",
  "description": "Self-hosted personal finance tracker for Mexico: Apple Pay, bank e-mails and statement PDFs in one private dashboard (Next.js 16 + SQL Server + Azure).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aplex2723/UzFinance.git"
  },
  "homepage": "https://github.com/Aplex2723/UzFinance#readme",
  "bugs": {
    "url": "https://github.com/Aplex2723/UzFinance/issues"
  },
  "keywords": [
    "personal-finance",
    "expense-tracker",
    "self-hosted",
    "nextjs",
    "azure",
    "sql-server",
    "mexico",
    "pwa",
    "apple-pay",
    "telegram-bot"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "docs:screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/spa": "^1.0.0",
    "clsx": "^2.1.1",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^1.55.0",
    "mssql": "^12.7.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-sankey": "^0.12.5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
